---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';
import {FULL_NAME} from "../../constants"
import IconLink from "../IconLink.astro"
---
<div class="bg-white dark:bg-gray-900 max-w-2xl mx-auto sm:rounded-md sm:shadow-md p-8 flex flex-col md:flex-row gap-x-6 gap-y-6 sm:gap-y-0 items-center">
    <div class="md:w-2/5 text-center md:-mt-8 flex sm:flex-col items-center">
        <Image class="h-32 rounded-full filter drop-shadow-md mx-auto" alt="Picture of Thomas" width={128} height={128} src={avatar}/>
        <div>
            <h1 class="text-gray-900 dark:text-gray-100 md:mt-6 md:ml-0 ml-6 text-xl font-bold">
                {FULL_NAME}
            </h1>
        </div>
    </div>
    <div class="md:w-4/5 text-gray-900 dark:text-gray-100 text-justify">
        <div class="space-y-4">
            <p>
                Hi, I'm Thomas!
            </p>
            <p>
                I am a master's student in Software Engineering at Ulm University.
                Previously, I worked at SEITENBAU, where I developed .NET backend services for one of Germany's leading streaming and TV platforms.
                My current interests are in developer tools, static analysis, and platform engineering.
            </p>
            <p>
                You can find some of my projects on
                <IconLink 
                    link="https://github.com/MaxAtoms" 
                    title="Go to my GitHub profile" 
                    text="GitHub" 
                    icon="bi-github"
                    />.

                If you want to learn more about me or get in touch, check out my
                <IconLink 
                    link="https://linkedin.com/in/thomasschoeller" 
                    title="Go to my LinkedIn profile" 
                    text="LinkedIn" 
                    icon="bi-linkedin"
                    /> profile.
            </p>
            <p>
                Oh, and by the way, here is my 
                <IconLink 
                    link="resume.pdf" 
                    title="Open my resume" 
                    text="resume" 
                    icon="bi-file-earmark-person-fill"
                    />.
            </p>
        </div>
    </div>
</div>