---
import Intro from "../components/sections/Intro.astro"
import "../styles/global.css";
import {FULL_NAME} from "../constants"
const pageTitle = FULL_NAME;
---

<html lang="en">

<head>
    <meta charset="utf-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Thomas M. Schöller, Software Developer">

    <meta property="og:title" content="Thomas M. Schöller"/>
    <meta property="og:site_name" content="Thomas M. Schöller">
    <meta property="og:type" content="website"/>
    <meta property="og:locale" content="en"/>

    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <title>{pageTitle}</title>
</head>

<body>

<main class="sm:bg-gray-200 dark:bg-gray-900 sm:dark:bg-gray-800 min-h-screen flex flex-col justify-center">
    <Intro/>
</main>

</body>

</html>
